@charset "utf-8";

:root { --navy: #123564; --blue: #1d4f8f; --cyan: #36d4e5; --yellow: #ffd21=
c; --paper: #f4f8fc; --text: #172b4d; }

* { box-sizing: border-box; }

body { margin: 0px; min-width: 320px; color: var(--text); background: radia=
l-gradient(circle at 10% 0%, rgba(54, 212, 229, 0.16), transparent 32rem),
        linear-gradient(145deg, #eaf4ff 0%, var(--paper) 50%, #fff 100%); f=
ont-family: Arial, Helvetica, sans-serif; line-height: 1.5; }

.container { width: min(1120px, 100% - 2rem); margin: 0px auto; }

header { padding: 4rem 0px 2.5rem; text-align: center; }

.eyebrow { display: inline-block; margin: 0px 0px 0.8rem; padding: 0.35rem =
0.9rem; border: 1px solid rgba(29, 79, 143, 0.2); border-radius: 999px; col=
or: var(--blue); background: rgba(255, 255, 255, 0.65); font-size: 0.8rem; =
font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }

h1 { max-width: 760px; margin: 0px auto; color: var(--navy); font-size: cla=
mp(2rem, 5vw, 4.2rem); line-height: 1.05; }

.intro { max-width: 640px; margin: 1.25rem auto 0px; color: rgb(82, 99, 125=
); font-size: clamp(1rem, 2vw, 1.15rem); }

main { padding-bottom: 4rem; }

.content-grid { display: grid; grid-template-columns: minmax(0px, 0.95fr) m=
inmax(0px, 1.05fr); gap: 2rem; align-items: start; }

.card { overflow: hidden; border: 1px solid rgba(18, 53, 100, 0.1); border-=
